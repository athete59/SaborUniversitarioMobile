{
  "expo": {
    "name": "Sabor Universitário",
    "slug": "sabor-universitario-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SaborUniLogo.png",
    "scheme": "saboruniversitariomobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/SaborUniLogo.png",
        "backgroundColor": "#FF7124"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SaborUniLogo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF7124"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
